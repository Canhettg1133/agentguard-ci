{
  "name": "agentguard-ci",
  "version": "0.1.1",
  "description": "Zero-config AI-native PR security guardrail & semantic code reviewer for GitHub Actions and local CLI",
  "main": "dist/index.js",
  "bin": {
    "agentguard": "dist/cli.js",
    "agentguard-ci": "dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "github-action",
    "security",
    "pr-reviewer",
    "code-quality",
    "secret-scanner",
    "prompt-injection",
    "ai-safety",
    "openai",
    "codex",
    "ci-cd"
  ],
  "author": "AgentGuard OSS Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Canhettg1133/agentguard-ci.git"
  },
  "bugs": {
    "url": "https://github.com/Canhettg1133/agentguard-ci/issues"
  },
  "homepage": "https://github.com/Canhettg1133/agentguard-ci#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "commander": "^12.1.0",
    "openai": "^4.86.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
